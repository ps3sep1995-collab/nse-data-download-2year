import os
import time
from datetime import datetime, timedelta
import requests
import hashlib
import pandas as pd
import io


def download_and_clean_nse_data():
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
        'Accept-Language': 'en-US,en;q=0.9',
        'Accept-Encoding': 'gzip, deflate, br',
        'Connection': 'keep-alive'
    }
    
    session = requests.Session()
    session.headers.update(headers)
    
    # पहले एनएसई की वेबसाइट से सेशन कुकीज़ प्राप्त करें
    try:
        session.get("https://www.nseindia.com", timeout=10)
    except Exception as e:
        print("NSE Connection Init Error:", e)
        return

    # पिछले 10 दिनों की अवधि सेट की गई है (आप इसे बदल सकते हैं)
    end_date = datetime.now()
    start_date = end_date - timedelta(days=10)
    
    current_date = start_date
    os.makedirs("Equity", exist_ok=True)

    print(f"डेटा डाउनलोड शुरू हो रहा है: {start_date.strftime('%Y-%m-%d')} से {end_date.strftime('%Y-%m-%d')} तक...\n")

    seen_hashes = {}
    downloaded_count = 0
    duplicate_count = 0

    # वांछित कॉलम जो हमें फाईल में रखने हैं
    target_columns = [
        'SYMBOL', 'DATE1', 'OPEN_PRICE', 'HIGH_PRICE', 
        'LOW_PRICE', 'CLOSE_PRICE', 'TTL_TRD_QNTY', 
        'NO_OF_TRADES', 'DELIV_QTY', 'DELIV_PER'
    ]

    # डेटा डाउनलोड और कॉलम फिल्टरिंग
    while current_date <= end_date:
        date_str_nse = current_date.strftime("%d%m%Y") # NSE URL के लिए DDMMYYYY
        date_str_file = current_date.strftime("%Y%b%d").upper() # EQ_2026APR01 फॉर्मेट के लिए
        
        file_path = f"Equity/EQ_{date_str_file}.txt"
        
        # अगर फाइल पहले से मौजूद नहीं है तभी डाउनलोड करें
        if not os.path.exists(file_path):
            url = f"https://archives.nseindia.com/products/content/sec_bhavdata_full_{date_str_nse}.csv"
            try:
                response = session.get(url, timeout=10)
                if response.status_code == 200 and len(response.content) > 1000:
                    
                    # Pandas का उपयोग करके केवल जरूरी कॉलम निकाले जा रहे हैं
                    df = pd.read_csv(io.BytesIO(response.content))
                    
                    # कॉलम के नाम से अतिरिक्त स्पेस (Extra spaces) हटाने के लिए
                    df.columns = df.columns.str.strip()
                    
                    # चेक करें कि सभी आवश्यक कॉलम मौजूद हैं या नहीं
                    available_cols = [col for col in target_columns if col in df.columns]
                    if available_cols:
                        df_filtered = df[available_cols].copy()
                        
                        # DATE1 कॉलम को YYYYMMDD फॉर्मेट (जैसे 20260401) में बदलना
                        if 'DATE1' in df_filtered.columns:
                            df_filtered['DATE1'] = pd.to_datetime(df_filtered['DATE1']).dt.strftime('%Y%m%d')
                        
                        # फ़िल्टर किए गए डेटा को टेक्स्ट (CSV/Comma-separated) फॉर्मेट में बदलना
                        processed_content = df_filtered.to_csv(index=False).encode('utf-8')
                        
                        # डाउनलोड करते ही मेमोरी में हैश निकालें
                        file_hash = hashlib.md5(processed_content).hexdigest()
                        
                        # चेक करें कि क्या यह डेटा पहले आ चुका है
                        if file_hash in seen_hashes:
                            print(f"डुप्लीकेट हटाई गई: EQ_{date_str_file}.txt (मूल फाइल: {seen_hashes[file_hash]})")
                            duplicate_count += 1
                        else:
                            # 'Equity' फोल्डर में फ़िल्टर किया हुआ डेटा सेव करें
                            with open(file_path, 'wb') as f:
                                f.write(processed_content)
                            seen_hashes[file_hash] = date_str_file
                            downloaded_count += 1
                            print(f"सफलतापूर्वक सेव हुआ: EQ_{date_str_file}.txt")
            except Exception as ex:
                print(f"Error on {date_str_file}: {ex}")
                pass
            
            time.sleep(1.2)
        else:
            # अगर फाइल पहले से मौजूद है, तो उसका भी हैश याद रखें
            try:
                with open(file_path, 'rb') as f:
                    file_hash = hashlib.md5(f.read()).hexdigest()
                    seen_hashes[file_hash] = date_str_file
            except:
                pass

        current_date += timedelta(days=1)

    print(f"\nप्रक्रिया पूरी हुई!")
    print(f"कुल नई फाइलें सेव हुईं: {downloaded_count}")
    print(f"कुल डुप्लीकेट फाइलें रोकी गईं: {duplicate_count}")
    print("अब 'Equity' फोल्डर में सही फॉर्मेट के साथ डेटा मौजूद है।")

if __name__ == "__main__":
    download_and_clean_nse_data()
