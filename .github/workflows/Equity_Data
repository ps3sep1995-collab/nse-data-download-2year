name: Download NSE Equity Data

on:
  schedule:
    # यह हर सोमवार से शुक्रवार शाम 6:30 बजे (IST) ऑटोमैटिक चलेगा (आप समय बदल सकते हैं)
    - cron: '30 13 * * 1-5'
  workflow_dispatch: # इससे आप इसे मैन्युअली भी GitHub से रन कर सकते हैं

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
      python-version: '3.10'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install requests pandas

    - name: Run download script
      run: python your_script_name.py  # यहाँ अपनी Python फाइल का नाम लिख लें (जैसे main.py)

    - name: Commit and push changes
      run: |
        git config --global user.name "GitHub Actions Bot"
        git config --global user.email "actions@github.com"
        git add Equity/
        git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update NSE Equity data" && git push)
